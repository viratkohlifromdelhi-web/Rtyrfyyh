rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped verified site owners (verifies email_verified == true to prevent spoofing)
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'sksandhya585@gmail.com',
          'viratkohlifromdelhi@gmail.com',
          'viratkohlifrommumbai@gmail.com'
        ];
    }

    // Single-lookup optional primitives (keeps CEL expression count well below 1,000 limit)
    function optStr(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    function optInt(v, minVal, maxVal) {
      return v == null || (v is int && v >= minVal && v <= maxVal);
    }

    function optNum(v, minVal, maxVal) {
      return v == null || ((v is int || v is float) && v >= minVal && v <= maxVal);
    }

    function optBool(v) {
      return v == null || v is bool;
    }

    // =========================================================================
    // Validation Blueprint: SiteVisit
    // =========================================================================
    function siteVisitAllowedKeys() {
      return [
        'sessionId', 'visitorId', 'visitNumber',
        'openedAt', 'openedAtMs', 'openedAtIST',
        'lastActiveAtMs', 'durationSeconds', 'maxScrollPct', 'totalInteractions',
        'deviceName', 'deviceType', 'osName', 'osVersion', 'browserName', 'inAppBrowser',
        'screenResolution', 'viewportSize', 'pixelRatio', 'colorDepth',
        'cpuCores', 'ramGb', 'gpuRenderer', 'touchPoints',
        'orientation', 'colorScheme', 'reducedMotion',
        'language', 'timezone', 'referrer', 'entryUrl', 'userAgent',
        'batteryLevel', 'batteryCharging', 'batteryChargingTime', 'batteryDischargingTime',
        'connectionType', 'effectiveType', 'downlinkMbps', 'rttMs', 'saveData',
        'ipAddress', 'city', 'region', 'postal', 'country', 'approxCoords', 'isp'
      ];
    }

    // Split into compact sub-validators to stay comfortably under Firestore's 1,000-expression cap
    function isValidSiteVisitCore(data) {
      return data.keys().hasOnly(siteVisitAllowedKeys())
        && isValidId(data.sessionId)
        && isValidId(data.visitorId)
        && data.visitNumber is int && data.visitNumber >= 1 && data.visitNumber <= 100000
        && data.openedAt is timestamp
        && data.openedAtMs is int && data.openedAtMs > 1700000000000 && data.openedAtMs < 4102444800000
        && data.openedAtIST is string && data.openedAtIST.size() <= 80
        && data.lastActiveAtMs is int && data.lastActiveAtMs >= data.openedAtMs && data.lastActiveAtMs < 4102444800000
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 604800
        && data.maxScrollPct is int && data.maxScrollPct >= 0 && data.maxScrollPct <= 100
        && data.totalInteractions is int && data.totalInteractions >= 0 && data.totalInteractions <= 50000;
    }

    function isValidSiteVisitDevice(data) {
      return data.deviceName is string && data.deviceName.size() <= 160
        && data.deviceType in ['Mobile', 'Tablet', 'Desktop']
        && data.osName is string && data.osName.size() <= 80
        && data.osVersion is string && data.osVersion.size() <= 80
        && data.browserName is string && data.browserName.size() <= 80
        && data.inAppBrowser is string && data.inAppBrowser.size() <= 80
        && data.screenResolution is string && data.screenResolution.size() <= 40
        && data.viewportSize is string && data.viewportSize.size() <= 40
        && (data.pixelRatio is int || data.pixelRatio is float) && data.pixelRatio > 0 && data.pixelRatio <= 16
        && data.colorDepth is int && data.colorDepth >= 0 && data.colorDepth <= 64
        && data.touchPoints is int && data.touchPoints >= 0 && data.touchPoints <= 64
        && data.orientation in ['portrait', 'landscape']
        && data.colorScheme in ['dark', 'light']
        && data.reducedMotion is bool
        && data.language is string && data.language.size() <= 40
        && data.timezone is string && data.timezone.size() <= 80
        && data.referrer is string && data.referrer.size() <= 512
        && data.entryUrl is string && data.entryUrl.size() <= 512
        && data.userAgent is string && data.userAgent.size() <= 600;
    }

    function isValidSiteVisitOptional(data) {
      return optInt(data.get('cpuCores', null), 0, 256)
        && optNum(data.get('ramGb', null), 0, 1024)
        && optStr(data.get('gpuRenderer', null), 240)
        && optInt(data.get('batteryLevel', null), 0, 100)
        && optBool(data.get('batteryCharging', null))
        && optNum(data.get('batteryChargingTime', null), 0, 10000000)
        && optNum(data.get('batteryDischargingTime', null), 0, 10000000)
        && optStr(data.get('connectionType', null), 60)
        && optStr(data.get('effectiveType', null), 40)
        && optNum(data.get('downlinkMbps', null), 0, 100000)
        && optNum(data.get('rttMs', null), 0, 100000)
        && optBool(data.get('saveData', null))
        && optStr(data.get('ipAddress', null), 80)
        && optStr(data.get('city', null), 120)
        && optStr(data.get('region', null), 120)
        && optStr(data.get('postal', null), 40)
        && optStr(data.get('country', null), 120)
        && optStr(data.get('approxCoords', null), 80)
        && optStr(data.get('isp', null), 180);
    }

    function isValidSiteVisitCreate(data, sessionId) {
      return isValidSiteVisitCore(data)
        && isValidSiteVisitDevice(data)
        && isValidSiteVisitOptional(data)
        && data.sessionId == sessionId
        && data.openedAt == request.time
        && data.durationSeconds == 0
        && data.totalInteractions == 0;
    }

    function siteVisitImmutableUnchanged() {
      return incoming().sessionId == existing().sessionId
        && incoming().visitorId == existing().visitorId
        && incoming().visitNumber == existing().visitNumber
        && incoming().openedAt == existing().openedAt
        && incoming().openedAtMs == existing().openedAtMs
        && incoming().openedAtIST == existing().openedAtIST;
    }

    function isValidHeartbeatPatch(data) {
      return data.lastActiveAtMs is int && data.lastActiveAtMs >= existing().openedAtMs && data.lastActiveAtMs < 4102444800000
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 604800
        && data.maxScrollPct is int && data.maxScrollPct >= 0 && data.maxScrollPct <= 100
        && data.totalInteractions is int && data.totalInteractions >= 0 && data.totalInteractions <= 50000;
    }

    function isValidGeoPatch(data) {
      return data.lastActiveAtMs is int && data.lastActiveAtMs >= existing().openedAtMs && data.lastActiveAtMs < 4102444800000
        && optStr(data.get('ipAddress', null), 80)
        && optStr(data.get('city', null), 120)
        && optStr(data.get('region', null), 120)
        && optStr(data.get('postal', null), 40)
        && optStr(data.get('country', null), 120)
        && optStr(data.get('approxCoords', null), 80)
        && optStr(data.get('isp', null), 180);
    }

    function isValidBatteryOrientationPatch(data) {
      return data.lastActiveAtMs is int && data.lastActiveAtMs >= existing().openedAtMs && data.lastActiveAtMs < 4102444800000
        && data.orientation in ['portrait', 'landscape']
        && optInt(data.get('batteryLevel', null), 0, 100)
        && optBool(data.get('batteryCharging', null))
        && optNum(data.get('batteryChargingTime', null), 0, 10000000)
        && optNum(data.get('batteryDischargingTime', null), 0, 10000000);
    }

    // =========================================================================
    // Validation Blueprint: VisitEvent
    // =========================================================================
    function isValidVisitEvent(data) {
      return data.keys().hasOnly([
          'eventTime', 'eventTimeMs', 'eventTimeIST',
          'elapsedSeconds', 'eventType', 'elementName', 'details'
        ])
        && data.eventTime is timestamp
        && data.eventTime == request.time
        && data.eventTimeMs is int && data.eventTimeMs > 1700000000000 && data.eventTimeMs < 4102444800000
        && data.eventTimeIST is string && data.eventTimeIST.size() <= 40
        && data.elapsedSeconds is int && data.elapsedSeconds >= 0 && data.elapsedSeconds <= 604800
        && data.eventType is string && data.eventType.size() >= 2 && data.eventType.size() <= 64
        && data.eventType.matches('^[a-z0-9_]+$')
        && data.elementName is string && data.elementName.size() >= 1 && data.elementName.size() <= 160
        && data.details is map && data.details.keys().size() <= 20;
    }

    // =========================================================================
    // Collection Rules: /site_visits/{sessionId}
    // =========================================================================
    match /site_visits/{sessionId} {
      // PII strictly restricted to verified owner
      allow get: if isValidId(sessionId) && isOwner();
      allow list: if isOwner();
      allow delete: if isValidId(sessionId) && isOwner();

      // Visitors can silently create their own session document
      allow create: if isValidId(sessionId)
        && isValidSiteVisitCreate(incoming(), sessionId);

      // Action-based allowlisted updates only (never mutates identity or openedAt)
      allow update: if isValidId(sessionId)
        && siteVisitImmutableUnchanged()
        && (
          (isOwner() && isValidSiteVisitCore(incoming()) && isValidSiteVisitDevice(incoming()) && isValidSiteVisitOptional(incoming()))
          || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastActiveAtMs', 'durationSeconds', 'maxScrollPct', 'totalInteractions'
            ])
            && isValidHeartbeatPatch(incoming())
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ipAddress', 'city', 'region', 'postal', 'country', 'approxCoords', 'isp', 'lastActiveAtMs'
            ])
            && isValidGeoPatch(incoming())
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'batteryLevel', 'batteryCharging', 'batteryChargingTime', 'batteryDischargingTime',
              'orientation', 'lastActiveAtMs'
            ])
            && isValidBatteryOrientationPatch(incoming())
          )
        );

      // =======================================================================
      // Subcollection Rules: /site_visits/{sessionId}/events/{eventId}
      // =======================================================================
      match /events/{eventId} {
        allow get: if isValidId(sessionId) && isValidId(eventId) && isOwner();
        allow list: if isValidId(sessionId) && isOwner();

        // Append-only interaction events linked to an existing parent session
        allow create: if isValidId(sessionId)
          && isValidId(eventId)
          && isValidVisitEvent(incoming())
          && exists(/databases/$(database)/documents/site_visits/$(sessionId));

        allow update: if false;
        allow delete: if isValidId(sessionId) && isValidId(eventId) && isOwner();
      }
    }

    // =========================================================================
    // Validation Blueprint & Collection Rules: /site_config/{docId}
    // =========================================================================
    function isValidGiftVaultConfig(data) {
      return data.keys().hasAll(['code', 'isRealCode', 'updatedAt', 'updatedAtMs'])
        && data.keys().hasOnly(['code', 'isRealCode', 'updatedAt', 'updatedAtMs'])
        && data.isRealCode is bool
        && data.code is string
        && data.code.size() <= 20
        && (
          (data.isRealCode == false && data.code == '')
          || (data.isRealCode == true && data.code.matches('^[A-Z0-9]{16,20}$'))
        )
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedAtMs is int
        && data.updatedAtMs > 1700000000000
        && data.updatedAtMs < 4102444800000;
    }

    function isValidTapliCounterCreate(data) {
      return data.keys().hasAll(['totalTaplis', 'updatedAt', 'updatedAtMs'])
        && data.keys().hasOnly(['totalTaplis', 'updatedAt', 'updatedAtMs'])
        && data.totalTaplis is int
        && data.totalTaplis >= 1
        && data.totalTaplis <= 500
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedAtMs is int
        && data.updatedAtMs > 1700000000000
        && data.updatedAtMs < 4102444800000;
    }

    function isValidTapliCounterUpdate(data, prev) {
      return data.keys().hasAll(['totalTaplis', 'updatedAt', 'updatedAtMs'])
        && data.keys().hasOnly(['totalTaplis', 'updatedAt', 'updatedAtMs'])
        && data.totalTaplis is int
        && prev.totalTaplis is int
        && data.totalTaplis > prev.totalTaplis
        && data.totalTaplis <= prev.totalTaplis + 500
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedAtMs is int
        && data.updatedAtMs > 1700000000000
        && data.updatedAtMs < 4102444800000;
    }

    function isValidTapliCounterOwnerReset(data) {
      return data.keys().hasAll(['totalTaplis', 'updatedAt', 'updatedAtMs'])
        && data.keys().hasOnly(['totalTaplis', 'updatedAt', 'updatedAtMs'])
        && data.totalTaplis is int
        && data.totalTaplis == 0
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedAtMs is int
        && data.updatedAtMs > 1700000000000
        && data.updatedAtMs < 4102444800000;
    }

    match /site_config/{docId} {
      allow get: if isValidId(docId) && (docId == 'gift_vault' || docId == 'tapli_counter');
      allow list: if false;
      allow create: if isValidId(docId)
        && (
          (docId == 'gift_vault' && isOwner() && isValidGiftVaultConfig(incoming()))
          || (
            docId == 'tapli_counter'
            && (
              isValidTapliCounterCreate(incoming())
              || (isOwner() && isValidTapliCounterOwnerReset(incoming()))
            )
          )
        );
      allow update: if isValidId(docId)
        && (
          (
            docId == 'gift_vault'
            && isOwner()
            && isValidGiftVaultConfig(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'isRealCode', 'updatedAt', 'updatedAtMs'
            ])
          )
          || (
            docId == 'tapli_counter'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalTaplis', 'updatedAt', 'updatedAtMs'
            ])
            && (
              isValidTapliCounterUpdate(incoming(), existing())
              || (isOwner() && isValidTapliCounterOwnerReset(incoming()))
            )
          )
        );
      allow delete: if false;
    }

    // =========================================================================
    // Validation Blueprint & Collection Rules: /developer_reviews/{reviewId}
    // =========================================================================
    function isValidDeveloperReview(data, reviewId) {
      return data.keys().hasAll([
          'reviewId', 'rating', 'isBonusRating', 'bestThings', 'message',
          'noteNumber', 'submittedAt', 'submittedAtMs', 'submittedAtIST',
          'sessionId', 'deviceType', 'sessionTaplis'
        ])
        && data.keys().hasOnly([
          'reviewId', 'rating', 'isBonusRating', 'bestThings', 'message',
          'noteNumber', 'submittedAt', 'submittedAtMs', 'submittedAtIST',
          'sessionId', 'deviceType', 'sessionTaplis'
        ])
        && data.reviewId is string
        && data.reviewId == reviewId
        && data.rating is int
        && data.rating in [1, 2, 3, 4, 5, 10]
        && data.isBonusRating is bool
        && (
          (data.rating == 10 && data.isBonusRating == true)
          || (data.rating != 10 && data.isBonusRating == false)
        )
        && data.bestThings is list
        && data.bestThings.size() <= 3
        && (
          data.bestThings.size() == 0
          || data.bestThings.hasOnly([
            'Origin Story Play',
            'Modino Pet',
            'Baad Me Reveal',
            'Tapli Arena',
            'Mini Chicken Farm',
            'Friend List',
            'Cake & Gift Vault',
            'Literally Everything'
          ])
        )
        && data.message is string
        && data.message.size() <= 1000
        && data.noteNumber is int
        && data.noteNumber >= 1
        && data.noteNumber <= 1000
        && data.submittedAt is timestamp
        && data.submittedAt == request.time
        && data.submittedAtMs is int
        && data.submittedAtMs > 1700000000000
        && data.submittedAtMs < 4102444800000
        && data.submittedAtIST is string
        && data.submittedAtIST.size() >= 1
        && data.submittedAtIST.size() <= 64
        && data.sessionId is string
        && data.sessionId.size() >= 4
        && data.sessionId.size() <= 128
        && data.deviceType is string
        && data.deviceType in ['Mobile', 'Tablet', 'Desktop']
        && data.sessionTaplis is int
        && data.sessionTaplis >= 0
        && data.sessionTaplis <= 100000;
    }

    match /developer_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && isOwner();
      allow list: if isOwner();
      allow create: if isValidId(reviewId)
        && isValidDeveloperReview(incoming(), reviewId);
      allow update: if false;
      allow delete: if isValidId(reviewId) && isOwner();
    }

    // =========================================================================
    // Validation Blueprint & Collection Rules: /time_capsules/{capsuleId}
    // =========================================================================
    function isValidTimeCapsule(data, capsuleId) {
      return data.keys().hasAll([
          'capsuleId', 'category', 'letter', 'capsuleNumber', 'unlockDate',
          'sealedAt', 'sealedAtMs', 'sealedAtIST', 'sessionId', 'deviceType'
        ])
        && data.keys().hasOnly([
          'capsuleId', 'category', 'letter', 'capsuleNumber', 'unlockDate',
          'sealedAt', 'sealedAtMs', 'sealedAtIST', 'sessionId', 'deviceType'
        ])
        && data.capsuleId is string
        && data.capsuleId == capsuleId
        && data.category is string
        && data.category in [
          'Big 18th Wish ✨',
          'Chaotic Prediction 😂',
          'Promise to Myself 🎀',
          'Note to Future Me 💌'
        ]
        && data.letter is string
        && data.letter.size() >= 3
        && data.letter.size() <= 1200
        && data.capsuleNumber is int
        && data.capsuleNumber >= 1
        && data.capsuleNumber <= 100
        && data.unlockDate is string
        && data.unlockDate == '03 Dec 2027'
        && data.sealedAt is timestamp
        && data.sealedAt == request.time
        && data.sealedAtMs is int
        && data.sealedAtMs > 1700000000000
        && data.sealedAtMs < 4102444800000
        && data.sealedAtIST is string
        && data.sealedAtIST.size() >= 1
        && data.sealedAtIST.size() <= 64
        && data.sessionId is string
        && data.sessionId.size() >= 4
        && data.sessionId.size() <= 128
        && data.deviceType is string
        && data.deviceType in ['Mobile', 'Tablet', 'Desktop'];
    }

    match /time_capsules/{capsuleId} {
      allow get: if isValidId(capsuleId) && isOwner();
      allow list: if isOwner();
      allow create: if isValidId(capsuleId)
        && isValidTimeCapsule(incoming(), capsuleId);
      allow update: if false;
      allow delete: if isValidId(capsuleId) && isOwner();
    }
  }
}
